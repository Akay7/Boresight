[Unit]
Description=Boresight light gun
Requires=boresight-gadget.service
After=boresight-gadget.service

[Service]
# @GUN@ is filled in by install.sh: the boresight-gun in the checkout's venv.
ExecStart=@GUN@ --config /etc/boresight-gun.toml
Restart=always
RestartSec=2
# Root, because the USB gadget and /dev/hidg0 are root's. The rest of the
# system is read-only to it. (No device allowlist: the camera stack opens a
# long and version-dependent list of nodes.)
User=root
NoNewPrivileges=yes
ProtectSystem=strict
# Read-only, not hidden: the checkout, and so the program, may be in /home.
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
